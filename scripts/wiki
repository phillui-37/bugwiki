#!/usr/bin/env bash
# wiki — tiny helper for the agent memory wiki (solutions + facts, typed edges).
# Usage: wiki init [target] | wiki find <terms> | wiki show <slug> | wiki new <domain> <slug>
#        wiki index | wiki lint | wiki verify [--migration] | wiki stale
#        wiki housekeep [--apply] | wiki list | wiki dream <export|commit|status>
set -euo pipefail

# resolve symlinks, so ~/.local/bin/wiki works
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  case "$_src" in /*) ;; *) _src="$_dir/$_src" ;; esac
done
# Two roots, on purpose.
#   PKG  — code + assets. Safe to sync across machines (chezmoi / git).
#   WIKI — content (solutions, facts, .raw, reports). Machine-local, never synced.
PKG="$(cd -P "$(dirname "$_src")/.." && pwd)"
WIKI="${WIKI_HOME:-$HOME/.agents/wiki}"
TODAY="$(date +%Y-%m-%d)"

# Housekeeping thresholds. Override any of them with the env var on the right.
STALE_DAYS="${WIKI_STALE_DAYS:-180}"      # page whose last_verified is older than N days: verify or mark obsolete
ARCHIVE_DAYS="${WIKI_ARCHIVE_DAYS:-90}"   # obsolete for N days: move out of solutions/ to archive/
LESSONS_MAX="${WIKI_LESSONS_MAX:-12}"     # max table rows in LESSONS.md before it is too long
DUP_JACCARD="${WIKI_DUP_JACCARD:-55}"     # oneliner token overlap percent that counts as a duplicate
DUP_MIN_PAGES="${WIKI_DUP_MIN_PAGES:-8}"  # do not run the duplicate scan below this page count
REPORTS_KEEP="${WIKI_REPORTS_KEEP:-30}"   # keep the newest N daily reports
STALE_FACT_DAYS="${WIKI_FACT_STALE_DAYS:-90}"      # stable fact: re-verify after N days (advisory)
STALE_PROMOTED_DAYS="${WIKI_PROMOTED_STALE_DAYS:-90}"  # a promoted rule that stops being true: demote it

die() { printf '%s\n' "$*" >&2; exit 1; }

field() { # field <file> <key>
  awk -v k="$2" '
    /^---[[:space:]]*$/ { n++; next }
    n==1 && index($0, k":")==1 {
      v=$0
      sub("^"k":[[:space:]]*", "", v)
      # a value that is only a trailing comment must read as empty
      if (k != "title") {
        sub(/#.*$/, "", v)
        gsub(/[[:space:]]+$/, "", v)
      }
      print v; exit
    }
  ' "$1"
}

# --- schema helpers -------------------------------------------------------

# field_list <file> <key> — inline list `[a, b]` as one entry per line.
# Only the inline form is supported: field() is line-oriented and a block list
# (`  - a` per line) cannot be read back reliably.
field_list() {
  local v
  v="$(field "$1" "$2")"
  v="${v#[}"; v="${v%]}"
  printf '%s\n' "$v" | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | sed '/^$/d'
}

# node_kind <file> — explicit kind, else derived from the path so that every
# page written before the schema existed reads correctly with no edit.
node_kind() {
  local k
  k="$(field "$1" kind)"
  if [ -n "$k" ]; then printf '%s' "$k"; return 0; fi
  case "${1#$WIKI/}" in
    solutions/*) printf 'solution' ;;
    facts/*)     printf 'fact' ;;
    .raw/*)      printf 'raw' ;;
    *)           printf 'solution' ;;
  esac
}

status_ok() { # status_ok <kind> <status>
  case "$1" in
    fact)     case "$2" in verified|open|obsolete|conflict) return 0 ;; esac ;;
    solution) case "$2" in verified|workaround|unconfirmed|active|obsolete|conflict) return 0 ;; esac ;;
    *)        return 0 ;;
  esac
  return 1
}

# node_paths <ref> [<from-file>] — resolve an edge target to real files.
# Accepts a relative path (resolved against <from-file>'s directory, which is
# what every page written before the schema uses) or a bare slug stem.
node_paths() {
  local ref="$1" from="${2:-}" cand dir
  case "$ref" in
    "") return 0 ;;
    /*) [ -f "$ref" ] && printf '%s\n' "$ref"; return 0 ;;
  esac
  if [ -n "$from" ]; then
    dir="$(dirname "$from")"
    cand="$dir/$ref"
    [ -f "$cand" ] && { (cd -P "$(dirname "$cand")" && printf '%s/%s\n' "$PWD" "$(basename "$cand")"); return 0; }
  fi
  [ -f "$WIKI/$ref" ] && { printf '%s\n' "$WIKI/$ref"; return 0; }
  find "$WIKI/solutions" "$WIKI/facts" -type f -name "$(basename "$ref").md" 2>/dev/null | sort
  return 0
}

node_label() { printf '%s' "$(basename "${1%.md}")"; }

search_roots() {
  local r
  for r in "$WIKI/solutions" "$WIKI/facts"; do [ -d "$r" ] && printf '%s\n' "$r"; done
}

cmd_find() {
  [ $# -gt 0 ] || die "usage: wiki find <terms>"
  local q="$*" hits one ono st fixed roots
  roots="$(search_roots)"
  # literal search by default: a query like "[" must be text, not a broken regex
  if [ "${WIKI_REGEX:-0}" = "1" ]; then fixed=""; else fixed="-F"; fi
  # shellcheck disable=SC2086
  hits="$(rg -il ${fixed:-} --glob '*.md' -- "$q" $roots 2>/dev/null)"
  st=$?
  if [ "$st" -gt 1 ]; then
    printf 'search error (rg exit %s) for: %s\n' "$st" "$q" >&2
    return 2
  fi
  [ "$st" -eq 0 ] || hits=""
  # a slug is a search key too: match file names when the query is one word
  case "$q" in
    *" "*) ;;
    *) hits="$hits
$(find $roots -type f -iname "*$q*.md" 2>/dev/null)" ;;
  esac
  hits="$(printf '%s\n' "$hits" | sed '/^$/d' | sort -u)"
  if [ -z "$hits" ]; then
    printf 'no match for: %s\n' "$q"
    printf 'try a shorter fragment, or: wiki list\n'
    return 0
  fi
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    printf '%s\n' "--- ${f#$WIKI/}  [$(node_kind "$f") · $(field "$f" status), recurrence $(field "$f" recurrence)]"
    one="$(field "$f" oneliner)"
    if [ -n "$one" ]; then printf '    = %s\n' "$one"; fi
    # the oneliner is already printed above; do not echo it twice
    ono="$(rg -n '^oneliner:' "$f" | head -1 | cut -d: -f1)"
    # a filename-only hit has no content match, and rg exit 1 must not kill the loop
    { rg -in -m4 ${fixed:-} -- "$q" "$f" || true; } \
      | awk -F: -v skip="${ono:-0}" '$1 != skip' | sed 's/^/    /' | head -4
  done <<< "$hits"
  return 0
}

cmd_list() {
  local f
  # both kinds: a fact must be as discoverable as a solution
  while IFS= read -r f; do
    case "${f#$WIKI/}" in
      solutions/*) printf '%s\n' "${f#$WIKI/solutions/}" | sed 's/\.md$//' ;;
      facts/*)     printf 'fact:%s\n' "$(basename "${f%.md}")" ;;
    esac
  done < <(all_pages)
}

cmd_new() {
  [ $# -eq 2 ] || die "usage: wiki new <domain> <slug>  |  wiki new fact <slug>"
  local domain="$1" slug="$2" dir="$WIKI/solutions/$1" file title
  if [ "$domain" = fact ]; then
    dir="$WIKI/facts"
    file="$dir/$slug.md"
    [ -e "$file" ] && die "exists: $file"
    mkdir -p "$dir"
    sed -e "s|^slug:.*|slug: $slug|" \
        -e "s|^valid_from:.*|valid_from: $TODAY|" \
        -e "s|^recorded_at:.*|recorded_at: $TODAY|" \
        -e "s|^verified_at:.*|verified_at: $TODAY|" \
        -e "s|^last_seen:.*|last_seen: $TODAY|" \
        "$PKG/assets/templates/fact.md" > "$file"
    printf '%s\n' "$file"
    return 0
  fi
  file="$dir/$slug.md"
  [ -e "$file" ] && die "exists: $file"
  mkdir -p "$dir"
  title="$(printf '%s' "$slug" | tr '-' ' ')"
  title="$(printf '%s' "$title" | awk '{print toupper(substr($0,1,1)) substr($0,2)}')"
  # the template lines carry trailing comments, so replace the whole line
  sed -e "s|^title:.*|title: $title|" \
      -e "s|^first_seen:.*|first_seen: $TODAY|" \
      -e "s|^last_seen:.*|last_seen: $TODAY|" \
      -e "s|^last_verified:.*|last_verified: $TODAY|" \
      "$WIKI/templates/entry.md" > "$file"
  cmd_index
  printf '%s\n' "$file"
}

cmd_index() {
  local readme tmp rf f header
  # A repo clone keeps README.md as documentation and puts the index in INDEX.md.
  # Detected structurally, not by an env var, so both layouts need no setup.
  readme="$WIKI/README.md"; header="# $(basename "$WIKI")"
  if [ -f "$WIKI/SKILL.md" ] && [ -d "$WIKI/scripts" ]; then
    readme="$WIKI/INDEX.md"; header="# Index"
  fi
  if [ ! -f "$readme" ]; then
    printf '%s\n' "$header" > "$readme"
  fi
  if ! rg -q '<!-- index:start -->' "$readme" 2>/dev/null; then
    # a repo clone keeps its README as documentation; the index is data
    if [ -f "$WIKI/SKILL.md" ] && [ -d "$WIKI/scripts" ]; then
      readme="$WIKI/INDEX.md"
      [ -f "$readme" ] || printf '# Index\n\n<!-- index:start -->\n<!-- index:end -->\n' > "$readme"
    else
      printf '\n## Index\n\n<!-- index:start -->\n<!-- index:end -->\n' >> "$readme"
    fi
  fi
  rf="$(mktemp)"
  while IFS= read -r f; do
    printf '| [%s](%s) | %s | %s | %s |\n' \
      "$(field "$f" title)" "${f#$WIKI/}" "$(basename "$(dirname "$f")")" \
      "$(field "$f" status)" "$(field "$f" last_seen)" >> "$rf"
  done < <(all_pages)

  tmp="$(mktemp)"
  awk -v rf="$rf" '
    /<!-- index:start -->/ {
      print; print ""
      print "| Page | Domain | Status | Last seen |"
      print "| --- | --- | --- | --- |"
      while ((getline l < rf) > 0) print l
      skip=1; next
    }
    /<!-- index:end -->/ { skip=0 }
    skip==1 { next }
    { print }
  ' "$readme" > "$tmp"
  mv "$tmp" "$readme"
  printf 'indexed %d entries\n' "$(wc -l < "$rf" | tr -d ' ')"
  rm -f "$rf"
}

# all_pages — every content page, deterministic order.
all_pages() {
  find "$WIKI/solutions" "$WIKI/facts" -type f -name '*.md' ! -name 'README.md' 2>/dev/null | sort
}

cmd_show() {
  [ $# -eq 1 ] || die "usage: wiki show <slug|relative-path>"
  local ref="$1" matches f kind st mat one vf vt va ex rec
  matches="$(node_paths "$ref")"
  [ -n "$matches" ] || { printf 'not found: %s\n' "$ref"; return 1; }
  if [ "$(printf '%s\n' "$matches" | wc -l | tr -d ' ')" -gt 1 ]; then
    printf 'ambiguous (%s matches), use a path:\n' "$(printf '%s\n' "$matches" | wc -l | tr -d ' ')"
    printf '  %s\n' ${matches#$WIKI/}
    return 2
  fi
  f="$matches"
  kind="$(node_kind "$f")"; st="$(field "$f" status)"; mat="$(field "$f" maturity)"
  one="$(field "$f" oneliner)"; [ -n "$one" ] || one="$(field "$f" title)"
  vf="$(field "$f" valid_from)"; vt="$(field "$f" valid_to)"
  va="$(field "$f" verified_at)"; [ -n "$va" ] || va="$(field "$f" last_verified)"
  ex="$(field "$f" expires)"; rec="$(field "$f" recurrence)"

  printf '%s  [%s%s  %s]\n' "$(node_label "$f")" "$kind" "${mat:+ · $mat}" "${st:-NO-STATUS}"
  [ -n "$one" ] && printf '  = %s\n' "$one"
  if [ -n "$vf" ] || [ -n "$vt" ]; then
    printf '  valid %s -> %s\n' "${vf:-?}" "${vt:-now}"
  fi
  [ -n "$va" ] && printf '  verified %s' "$va"
  [ -n "$ex" ] && [ "$ex" != null ] && printf '   expires %s' "$ex"
  [ -n "$rec" ] && printf '   recurrence %s' "$rec"
  printf '\n'

  local key refs t
  for key in supersedes contradicts related; do
    refs="$(field_list "$f" "$key")"
    [ -n "$refs" ] || continue
    printf '  %s:\n' "$key"
    while IFS= read -r t; do
      [ -n "$t" ] || continue
      printf '    -> %s\n' "$t"
    done <<< "$refs"
  done

  # inbound edges: who claims this node. This is the line that stops an obsolete
  # node being read as current, so it is printed even when empty.
  local other from
  other=""
  while IFS= read -r from; do
    [ -n "$from" ] || continue
    [ "$from" = "$f" ] && continue
    if grep -q -- "$(node_label "$f")" <(field_list "$from" supersedes; field_list "$from" contradicts) 2>/dev/null; then
      other="$other$from\n"
    fi
  done < <(all_pages)
  if [ -n "$other" ]; then
    printf '  superseded/contradicted by:\n'
    while IFS= read -r t; do [ -n "$t" ] && printf '    <- %s\n' "$(node_label "$t")"; done <<< "$(printf '%b' "$other")"
  fi

  # follow the supersession chain to its tail: 1 hop is not enough
  local cur hops nxt found
  cur="$f"; hops=0
  while [ "$hops" -lt 10 ]; do
    nxt=""
    while IFS= read -r from; do
      [ -n "$from" ] || continue
      case "$(field_list "$from" supersedes)" in
        *"$(node_label "$cur")"*) nxt="$from"; break ;;
      esac
    done < <(all_pages)
    [ -n "$nxt" ] || break
    cur="$nxt"; hops=$((hops + 1))
    printf '  -> chain %s: %s [%s]\n' "$hops" "$(node_label "$cur")" "$(field "$cur" status)"
  done
  [ "$hops" -eq 0 ] || printf '  (current endpoint: %s)\n' "$(node_label "$cur")"
  return 0
}

cmd_stale() {
  local f kind st exp seen epoch now age n=0
  now="$(date +%s)"
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    st="$(field "$f" status)"
    [ "$st" = obsolete ] && continue
    [ "$st" = conflict ] && { printf 'conflict  %s\n' "${f#$WIKI/}"; n=$((n + 1)); continue; }
    kind="$(node_kind "$f")"
    exp="$(field "$f" expires)"
    if [ -n "$exp" ] && [ "$exp" != null ]; then
      epoch="$(date -j -f %Y-%m-%d "$exp" +%s 2>/dev/null || echo 0)"
      if [ "$epoch" -gt 0 ] && [ "$now" -ge "$epoch" ]; then
        printf 'expired   %s  [%s, expires %s]\n' "${f#$WIKI/}" "$kind" "$exp"; n=$((n + 1)); continue
      fi
    fi
    seen="$(field "$f" verified_at)"
    [ -n "$seen" ] || seen="$(field "$f" last_verified)"
    [ -n "$seen" ] || seen="$(field "$f" last_seen)"
    [ -n "$seen" ] || continue
    epoch="$(date -j -f %Y-%m-%d "$seen" +%s 2>/dev/null || echo 0)"
    [ "$epoch" -gt 0 ] || continue
    age=$(( (now - epoch) / 86400 ))
    local limit="$STALE_DAYS"
    case "$kind" in
      fact) [ "$(field "$f" maturity)" = promoted ] && limit="$STALE_PROMOTED_DAYS" || limit="$STALE_FACT_DAYS" ;;
    esac
    if [ "$age" -ge "$limit" ]; then
      printf 'stale     %s  [%s, %sd > %sd]\n' "${f#$WIKI/}" "$kind" "$age" "$limit"; n=$((n + 1))
    fi
  done < <(all_pages)
  [ "$n" -eq 0 ] && printf 'nothing stale\n'
  return 0
}

cmd_verify() {
  local mode="${1:-}" f kind st d refs t bad=0 n=0
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    n=$((n + 1))
    if [ "$(head -1 "$f")" != "---" ]; then
      printf 'err  no frontmatter: %s\n' "${f#$WIKI/}"; bad=1; continue
    fi
    if [ "$(grep -c '^---[[:space:]]*$' "$f")" -lt 2 ]; then
      printf 'err  unterminated frontmatter: %s\n' "${f#$WIKI/}"; bad=1; continue
    fi
    kind="$(node_kind "$f")"
    st="$(field "$f" status)"
    if [ -n "$st" ] && ! status_ok "$kind" "$st"; then
      printf 'err  bad status for %s (%s): %s\n' "$kind" "$st" "${f#$WIKI/}"; bad=1
    fi
    for d in valid_from valid_to recorded_at verified_at expires first_seen last_seen obsolete_since; do
      local v
      v="$(field "$f" "$d")"
      case "$v" in
        ""|null) ;;
        [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) date -j -f %Y-%m-%d "$v" +%s >/dev/null 2>&1 || { printf 'err  bad date %s=%s: %s\n' "$d" "$v" "${f#$WIKI/}"; bad=1; } ;;
        *) printf 'err  date not YYYY-MM-DD %s=%s: %s\n' "$d" "$v" "${f#$WIKI/}"; bad=1 ;;
      esac
    done
    # every edge must resolve, or the graph has a dead end
    for key in supersedes contradicts related; do
      refs="$(field_list "$f" "$key")"
      [ -n "$refs" ] || continue
      while IFS= read -r t; do
        [ -n "$t" ] || continue
        if [ -z "$(node_paths "$t" "$f")" ]; then
          printf 'err  %s edge does not resolve (%s): %s\n' "$key" "$t" "${f#$WIKI/}"; bad=1
        fi
      done <<< "$refs"
    done
  done < <(all_pages)
  if [ "$bad" -eq 0 ]; then
    printf 'verify ok: %s pages (%s)\n' "$n" "${mode:-schema}"
    return 0
  fi
  printf 'verify FAILED\n'
  return 1
}

cmd_lint() {
  local bad=0 adv=0 f status seen title epoch now rec
  now="$(date +%s)"
  while IFS= read -r f; do
    title="$(field "$f" title)"
    [ -n "$title" ] || title="$(field "$f" slug)"
    status="$(field "$f" status)"
    seen="$(field "$f" last_verified)"
    [ -n "$seen" ] || seen="$(field "$f" last_seen)"
    rec="$(field "$f" recurrence)"
    if [ -z "$title" ]; then printf 'missing title: %s\n' "${f#$WIKI/}"; bad=1; fi
    if [ -z "$status" ]; then
      printf 'missing status: %s\n' "${f#$WIKI/}"; bad=1
    elif ! status_ok "$(node_kind "$f")" "$status"; then
      printf 'bad status for %s (%s): %s\n' "$(node_kind "$f")" "$status" "${f#$WIKI/}"; bad=1
    fi
    # a fact with no body is a stub that passed the gate because it has
    # frontmatter; the body is where the evidence lives
    if [ "$(node_kind "$f")" = fact ]; then
      local body
      body="$(awk 'BEGIN{n=0} /^---[[:space:]]*$/{n++; next} n>=2' "$f" | tr -d '[:space:]' | wc -c | tr -d ' ')"
      if [ "$body" -lt 200 ]; then
        printf 'thin fact body (%s chars < 200): %s\n' "$body" "${f#$WIKI/}"; bad=1
      fi
      if [ "$(field "$f" title)" = "$(field "$f" oneliner)" ]; then
        printf 'advisory: title repeats oneliner: %s\n' "${f#$WIKI/}"
      fi
    fi
    # every edge must resolve: a graph with dead ends is worse than no graph
    local key refs t
    for key in supersedes contradicts related; do
      refs="$(field_list "$f" "$key")"
      [ -n "$refs" ] || continue
      while IFS= read -r t; do
        [ -n "$t" ] || continue
        if [ -z "$(node_paths "$t" "$f")" ]; then
          printf 'dead %s edge (%s): %s\n' "$key" "$t" "${f#$WIKI/}"; bad=1
        fi
      done <<< "$refs"
    done
    case "$rec" in
      "") printf 'missing recurrence: %s\n' "${f#$WIKI/}"; bad=1 ;;
      *[!0-9]*) printf 'bad recurrence (%s): %s\n' "$rec" "${f#$WIKI/}"; bad=1 ;;
      *) if [ "$rec" -ge 2 ]; then printf 'promote to LESSONS.md (%s days): %s\n' "$rec" "${f#$WIKI/}"; adv=1; fi ;;
    esac
    local limit="$STALE_DAYS"
    case "$(node_kind "$f")" in
      fact) if [ "$(field "$f" maturity)" = promoted ]; then limit="$STALE_PROMOTED_DAYS"; else limit="$STALE_FACT_DAYS"; fi ;;
    esac
    if [ -n "$seen" ] && epoch="$(date -j -f %Y-%m-%d "$seen" +%s 2>/dev/null)"; then
      if [ $(( (now - epoch) / 86400 )) -ge "$limit" ] && [ "$status" != obsolete ]; then
        printf 'stale (%s days > %s, %s): %s\n' "$(( (now - epoch) / 86400 ))" "$limit" "$status" "${f#$WIKI/}"
      fi
    fi
  done < <(all_pages)
  if [ "$bad" -eq 0 ] && [ "$adv" -eq 0 ]; then printf 'lint clean\n'; fi
  [ "$bad" -eq 0 ] || return 1
  return 0
}

cmd_housekeep() {
  local apply="${1:-}" f status seen oseen epoch now age pages lessons_rows
  local report archived=0 tsv
  local verify_list="" promote_list="" dup_list="" archive_list="" odo_list="" collision_list=""
  now="$(date +%s)"
  mkdir -p "$WIKI/reports"
  report="$WIKI/reports/$TODAY.md"

  pages="$(find "$WIKI/solutions" -type f -name '*.md' ! -name 'README.md' | wc -l | tr -d ' ')"

  # 1. obsolete long enough to leave circulation. Age is counted from
  #    obsolete_since, not last_seen: marking a page obsolete must not archive it
  #    the same day. A page without obsolete_since is reported, never moved.
  while IFS= read -r f; do
    status="$(field "$f" status)"
    [ "$status" = obsolete ] || continue
    oseen="$(field "$f" obsolete_since)"
    if [ -z "$oseen" ]; then
      odo_list="$odo_list- ${f#$WIKI/} (obsolete, no obsolete_since)\n"
      continue
    fi
    epoch="$(date -j -f %Y-%m-%d "$oseen" +%s 2>/dev/null || echo "$now")"
    age=$(( (now - epoch) / 86400 ))
    if [ "$age" -ge "$ARCHIVE_DAYS" ]; then archive_list="$archive_list- ${f#$WIKI/} (obsolete ${age}d)\n"; fi
  done < <(find "$WIKI/solutions" -type f -name '*.md' ! -name 'README.md' | sort)

  if [ "$apply" = "--apply" ]; then
    while IFS= read -r f; do
      status="$(field "$f" status)"
      [ "$status" = obsolete ] || continue
      oseen="$(field "$f" obsolete_since)"
      [ -n "$oseen" ] || continue
      epoch="$(date -j -f %Y-%m-%d "$oseen" +%s 2>/dev/null || echo "$now")"
      age=$(( (now - epoch) / 86400 ))
      [ "$age" -ge "$ARCHIVE_DAYS" ] || continue
      dest="$WIKI/archive/$(basename "$(dirname "$f")")"
      mkdir -p "$dest"
      if [ -e "$dest/$(basename "$f")" ]; then
        # never overwrite an archived page; a human decides which one survives
        collision_list="$collision_list- ${f#$WIKI/} -> archive/$(basename "$(dirname "$f")")/$(basename "$f") exists, skipped\n"
        continue
      fi
      mv "$f" "$dest/"
      archived=$((archived + 1))
    done < <(find "$WIKI/solutions" -type f -name '*.md' ! -name 'README.md' | sort)
    archive_list=""
    cmd_index >/dev/null
    # keep the newest reports only
    ls -1t "$WIKI/reports" 2>/dev/null | tail -n +$((REPORTS_KEEP + 1)) | while IFS= read -r old; do
      rm -f "$WIKI/reports/$old"
    done
  fi

  # 2. promote to LESSONS.md, and pages that went stale
  while IFS= read -r f; do
    local rec seen2
    rec="$(field "$f" recurrence)"
    case "$rec" in ''|*[!0-9]*) rec=1 ;; esac
    if [ "$rec" -ge 2 ]; then promote_list="$promote_list- ${f#$WIKI/} (recurrence ${rec})\n"; fi
    # validity, not recurrence: last_verified wins, last_seen is the fallback
    seen2="$(field "$f" last_verified)"
    [ -n "$seen2" ] || seen2="$(field "$f" last_seen)"
    epoch="$(date -j -f %Y-%m-%d "${seen2:-$TODAY}" +%s 2>/dev/null || echo "$now")"
    age=$(( (now - epoch) / 86400 ))
    status="$(field "$f" status)"
    if [ "$age" -ge "$STALE_DAYS" ] && [ "$status" != obsolete ]; then
      verify_list="$verify_list- ${f#$WIKI/} (${age}d, ${status})\n"
    fi
  done < <(find "$WIKI/solutions" -type f -name '*.md' ! -name 'README.md' | sort)

  # 3. duplicate candidates: token overlap on oneliner
  if [ "$pages" -ge "$DUP_MIN_PAGES" ]; then
    tsv="$(mktemp)"
    while IFS= read -r f; do
      printf '%s\t%s\n' "${f#$WIKI/}" "$(field "$f" oneliner)" >> "$tsv"
    done < <(find "$WIKI/solutions" -type f -name '*.md' ! -name 'README.md' | sort)
    dup_list="$(awk -F'\t' -v th="$DUP_JACCARD" '
      {
        n++; path[n]=$1
        m=split(tolower($2), w, /[^a-z0-9]+/)
        # a set, not a bag: a repeated word must not inflate the overlap
        for (i=1;i<=m;i++) if (length(w[i])>3 && !((n SUBSEP w[i]) in S)) { S[n SUBSEP w[i]]=1; T[n, ++c[n]]=w[i] }
      }
      END {
        for (i=1;i<n;i++) for (j=i+1;j<=n;j++) {
          if (c[i]==0 || c[j]==0) continue
          inter=0
          for (k=1;k<=c[i];k++) if ((j SUBSEP T[i,k]) in S) inter++
          union=c[i]+c[j]-inter
          if (union>0 && inter*100/union >= th)
            printf "- %s  <->  %s  (%d%% overlap)\n", path[i], path[j], inter*100/union
        }
      }' "$tsv")"
    rm -f "$tsv"
  else
    dup_list="- skipped: ${pages} pages, scan starts at ${DUP_MIN_PAGES}\n"
  fi

  lessons_rows="$(awk '/^\|/ { if ($0 ~ /^\|[[:space:]]*---/) next; if ($0 ~ /^\|[[:space:]]*Rule/) next; c++ } END { print c+0 }' "$WIKI/LESSONS.md" 2>/dev/null || echo 0)"

  {
    printf '# Wiki housekeeping — %s\n\n' "$TODAY"
    printf 'Thresholds: stale **%sd**, archive obsolete after **%sd**, LESSONS max **%s rows**, duplicate >= **%s%%** oneliner overlap (scan starts at %s pages).\n\n' \
      "$STALE_DAYS" "$ARCHIVE_DAYS" "$LESSONS_MAX" "$DUP_JACCARD" "$DUP_MIN_PAGES"
    printf 'Pages: %s | LESSONS rows: %s | mode: %s\n\n' "$pages" "$lessons_rows" "${apply:---report}"
    printf '## Archive queue (moved now: %s)\n\n' "$archived"
    [ -n "$archive_list" ] && printf '%b' "$archive_list" || printf -- '- none\n'
    if [ -n "$collision_list" ]; then
      printf '\n## Archive collisions (not moved)\n\n'
      printf '%b' "$collision_list"
    fi
    if [ -n "$odo_list" ]; then
      printf '\n## Obsolete without obsolete_since\n\n'
      printf '%b' "$odo_list"
    fi
    printf '\n## Promote to LESSONS.md\n\n'
    [ -n "$promote_list" ] && printf '%b' "$promote_list" || printf -- '- none\n'
    printf '\n## Verify or mark obsolete (last_verified older than %sd)\n\n' "$STALE_DAYS"
    [ -n "$verify_list" ] && printf '%b' "$verify_list" || printf -- '- none\n'
    printf '\n## Duplicate candidates\n\n'
    printf '%b' "$dup_list"
    if [ "$lessons_rows" -gt "$LESSONS_MAX" ]; then
      printf '\n## LESSONS.md too long\n\n- %s rows, max %s: promote to AGENTS.md or drop the dead ones\n' "$lessons_rows" "$LESSONS_MAX"
    fi
    printf '\n---\nNo page is deleted. `--apply` moves obsolete pages (age counted from `obsolete_since`) into `archive/`, and never overwrites an existing archived file. `reports/` keeps the newest %s.\n' "$REPORTS_KEEP"
  } > "$report"

  printf 'report: %s\n' "$report"
  printf 'pages %s | archived %s | promote %s | stale %s | lessons rows %s/%s\n' \
    "$pages" "$archived" "$(printf '%b' "$promote_list" | grep -c '^- ' || true)" \
    "$(printf '%b' "$verify_list" | grep -c '^- ' || true)" "$lessons_rows" "$LESSONS_MAX"
  return 0
}


# --- dream ---------------------------------------------------------------
# The dream is a means, not a store: it produces fact pages in the same wiki.
# The analysis itself is an agent step (SKILL.md); these commands only do the
# parts an agent is bad at -- fetching every page, and committing atomically.

cmd_dream() {
  local sub="${1:-status}"
  shift 2>/dev/null || true
  case "$sub" in
    begin|progress|read|source|ack|complete|own|amend|resolve|commit)
      local workflow
      workflow="$(cd -P "$(dirname "$_src")" && pwd)/dream-workflow.py"
      [ -f "$workflow" ] || die "missing $workflow"
      local action="$sub"
      if [ "$action" = progress ]; then action=status; fi
      python3 "$workflow" --root "$WIKI" "$action" "$@" ;;
    status)
      local workflow
      workflow="$(cd -P "$(dirname "$_src")" && pwd)/dream-workflow.py"
      python3 "$workflow" --root "$WIKI" status ;;
    export)
      # resolve next to the running script: this CLI lives in bin/ in a dev
      # checkout and in scripts/ once installed as a skill, and hardcoding
      # either path is how a nightly run dies at 01:00 with nothing written
      local helper
      helper="$(cd -P "$(dirname "$_src")" && pwd)/dream-export.py"
      [ -x "$helper" ] || die "missing $helper"
      "$helper" --content-root "$WIKI" "$@" ;;
    *) die "usage: wiki dream <export|begin|progress|read|source|ack|complete|own|amend|resolve|commit|status> [options]" ;;
  esac
}

cmd_init() { # cmd_init [target] — scaffold a wiki from the skill's assets
  local target="${1:-$WIKI}" assets="" f in_place=0
  local script_dir
  script_dir="$(cd -P "$(dirname "$_src")" && pwd)"
  # assets ship with the skill; fall back to the running wiki's own docs
  if [ -d "$script_dir/../assets" ]; then
    assets="$(cd -P "$script_dir/../assets" && pwd)"
  elif [ -d "$WIKI/templates" ]; then
    assets="$WIKI"
  fi
  [ -n "$assets" ] || die "no assets found next to the script"

  # allow an in-place init when the target is this package (git clone -> init)
  if [ -d "$target" ] && [ -n "$(ls -A "$target" 2>/dev/null)" ]; then
    if [ -f "$target/scripts/wiki" ] && [ -d "$target/assets" ]; then
      in_place=1
    else
      die "target is not empty and is not this package: $target"
    fi
  fi
  # content root only: code lives in PKG, not here
  mkdir -p "$target/solutions" "$target/facts" "$target/templates" \
           "$target/reports" "$target/archive" "$target/.raw"

  # BSD cp -n exits 1 when it skips, which kills the script under set -e,
  # so test existence explicitly instead
  for f in README.md LESSONS.md; do
    if [ -f "$assets/$f" ] && [ ! -e "$target/$f" ]; then cp "$assets/$f" "$target/$f"; fi
  done
  if [ -f "$assets/templates/entry.md" ] && [ ! -e "$target/templates/entry.md" ]; then
    cp "$assets/templates/entry.md" "$target/templates/entry.md"
  elif [ -f "$assets/entry.md" ] && [ ! -e "$target/templates/entry.md" ]; then
    cp "$assets/entry.md" "$target/templates/entry.md"
  fi
  if [ -f "$assets/AGENTS-block.md" ] && [ ! -e "$target/AGENTS-snippet.md" ]; then
    cp "$assets/AGENTS-block.md" "$target/AGENTS-snippet.md"
  fi

  # A separate content repo versions knowledge and reports, not raw exports.
  # Never replace ignore rules in an existing checkout.
  if [ "$in_place" = "0" ] && [ ! -e "$target/.gitignore" ]; then
    printf '/.raw/\n/.dream/\n' > "$target/.gitignore"
  fi
  WIKI_HOME="$target" bash "$script_dir/wiki" index >/dev/null

  if [ "$in_place" = "1" ]; then
    printf 'wiki:  %s (legacy in-place layout; use a separate content root for dream commits)\n' "$target"
  else
    printf 'wiki:  %s\n' "$target"
  fi
  printf 'code:  %s/wiki\n' "$script_dir"
  printf '\nnext:\n'
  printf '  1. mkdir -p ~/.local/bin && ln -sf "%s/wiki" ~/.local/bin/wiki\n' "$script_dir"
  printf '  2. set WIKI_HOME="%s" and add ~/.local/bin to PATH\n' "$target"
  printf '  3. append %s/AGENTS-snippet.md to your agents instruction file\n' "$target"
  printf '  4. git -C "%s" init              # local content history, before dream\n' "$target"
  return 0
}

case "${1:-}" in
  init) shift; cmd_init "$@" ;;
  find) shift; cmd_find "$@" ;;
  show) shift; cmd_show "$@" ;;
  stale) cmd_stale ;;
  verify) shift; cmd_verify "$@" ;;
  list) cmd_list ;;
  new) shift; cmd_new "$@" ;;
  index) cmd_index ;;
  lint) cmd_lint ;;
  housekeep) shift; cmd_housekeep "$@" ;;
  dream) shift; cmd_dream "$@" ;;
  *) sed -n '2,3p' "${BASH_SOURCE[0]}" | sed 's/^# //'; exit 1 ;;
esac
